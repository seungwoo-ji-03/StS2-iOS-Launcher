<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline scenario tests for SyncManager: the real SyncManager.cs compiled against a tiny Godot shim and
       an in-memory fake Steam Cloud. Never touches a real Steam account. Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../SyncManager.cs" />
    <Compile Include="../IosNative.cs" />
    <Compile Include="../gen/CloudMin.cs" />
  </ItemGroup>
</Project>
